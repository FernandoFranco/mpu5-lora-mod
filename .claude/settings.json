{
  "permissions": {
    "deny": [
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git clean*)",
      "Bash(*settings.json*)",
      "Bash(*config.json*)",
      "Bash(*.claude*)",
      "Bash(chmod*)",
      "Edit(.claude/*)",
      "Edit(*settings.json*)",
      "Write(.claude/*)",
      "Write(*settings.json*)"
    ],
    "allow": ["Bash(git status)", "Bash(git log*)", "Bash(git diff*)", "Bash(git show*)"]
  }
}
